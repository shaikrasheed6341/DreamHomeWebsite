generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  firstname String
  lastname  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id          Int      @id @default(autoincrement())
  username    String
  email       String
  phonenumber String
  createdAt   DateTime @default(now())
}

model Cart {
  id        Int     @id @default(autoincrement())
  place     String
  rooms     String
  squrefeet String
  proparty  String?
  price     String?
}

model Contact {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phonenumber String
  location    String
  createAt    DateTime @default(now())
}
